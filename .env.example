# Safe local defaults. Copy to .env and set AI_PROVIDER=ollama to enable local AI.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Keep cloud execution disabled for a local presentation unless you deliberately deploy it.
AWS_RUNTIME_ENABLED=false
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# Local intake boundaries.
MAX_UPLOAD_MB=5
MAX_FILES=500
MAX_FILE_BYTES=1048576
