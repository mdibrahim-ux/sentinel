# Safe defaults. Copy to .env; AI_PROVIDER can be disabled, ollama, openrouter, openai, or bedrock.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional cloud AI via OpenRouter. Keep your real key in .env, never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Keep cloud execution disabled for a local presentation unless you deliberately deploy it.
AWS_RUNTIME_ENABLED=false
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# Local intake boundaries.
MAX_UPLOAD_MB=5
MAX_FILES=500
MAX_FILE_BYTES=1048576
